{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonmold/primitive-building-result@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "product_id",
    "operation",
    "plan_id",
    "plan_ref",
    "input_digest",
    "plan_digest",
    "live_evidence_ref",
    "editable_model_ref",
    "digital_mesh_ref",
    "stl_candidate_ref",
    "presentation_ref",
    "verified_outputs",
    "object_count",
    "bounds_meters",
    "runtime",
    "execution_provenance",
    "claim_ceiling",
    "physical_effects",
    "simulation_evidence",
    "manufacturing_authority",
    "documented_target_qualified",
    "preserved_unknowns"
  ],
  "properties": {
    "contract_id": {
      "const": "moonmold/primitive-building-result@1.0.0"
    },
    "product_id": {
      "const": "moonmold"
    },
    "operation": {
      "const": "moonmold/primitive.build@0.3.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "live_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "editable_model_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "digital_mesh_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "stl_candidate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "presentation_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "verified_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model.blend",
        "model.glb",
        "model.stl",
        "render.png",
        "bridge-manifest.json"
      ],
      "properties": {
        "model.blend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "size"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 64
            }
          }
        },
        "model.glb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "size"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 64
            }
          }
        },
        "model.stl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "size"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 64
            }
          }
        },
        "render.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "size"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 64
            }
          }
        },
        "bridge-manifest.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "size"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 64
            }
          }
        }
      }
    },
    "object_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 32
    },
    "bounds_meters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "executable_digest",
        "fixed_bridge_digest",
        "adapter_source_digest",
        "compatibility",
        "documented_target",
        "documented_target_qualified"
      ],
      "properties": {
        "executable": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "executable_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "fixed_bridge_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "adapter_source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "compatibility": {
          "const": "experimental-observed-runtime"
        },
        "documented_target": {
          "const": "Blender 4.5.11 LTS"
        },
        "documented_target_qualified": {
          "const": false
        }
      }
    },
    "execution_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "evidence_class",
        "fixed_bridge_digest",
        "outcome",
        "unrestricted_scripts",
        "verified_references"
      ],
      "properties": {
        "authority": {
          "const": "workspace-digital-modeling-only"
        },
        "evidence_class": {
          "const": "live-blender"
        },
        "fixed_bridge_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": [
            "applied",
            "idempotent-no-op"
          ]
        },
        "unrestricted_scripts": {
          "const": false
        },
        "verified_references": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claim_ceiling": {
      "const": "digital-artifact"
    },
    "physical_effects": {
      "const": false
    },
    "simulation_evidence": {
      "const": false
    },
    "manufacturing_authority": {
      "const": false
    },
    "documented_target_qualified": {
      "const": false
    },
    "preserved_unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  }
}
