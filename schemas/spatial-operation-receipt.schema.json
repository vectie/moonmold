{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonmold.spatial-operation-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "request_id", "idempotency_key", "outcome", "before_digest", "after_digest", "claim_ceiling", "physical_authority"],
  "properties": {
    "contract_id": {"const": "moonmold.spatial-operation-receipt.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["applied", "idempotent-no-op", "rejected"]},
    "before_digest": {"type": "string", "minLength": 1},
    "after_digest": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "physical_authority": {"const": false},
    "artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
